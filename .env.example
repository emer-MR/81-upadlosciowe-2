# Local dev defaults — kopiuj do .env i edytuj.
DEBUG=True
SECRET_KEY=django-insecure-change-me-dev-only
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
COMING_SOON=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
DJANGO_LOG_LEVEL=INFO

# Email (dev: filebased zapisuje maile do sent_emails/, console wypisuje do stdout)
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_FILE_PATH=sent_emails
DEFAULT_FROM_EMAIL=upadlosciowe.pl <kontakt@upadlosciowe.pl>
OPERATOR_EMAIL=kontakt@upadlosciowe.pl

# Dane biura (stopka, strona kontakt, domyślny kontakt ofert)
OPERATOR_NAZWA=Kancelaria syndyka
OPERATOR_ADRES=
OPERATOR_TELEFON=
OPERATOR_NIP=
OPERATOR_KRS=

# Anti-spam: Cloudflare Turnstile (puste = walidacja pomijana, formularze działają normalnie)
# Konfiguracja prod: cloudflare.com → Turnstile → Add Site → mode "Managed"
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Production example (Hostinger VPS, Traefik za HTTPS):
# DEBUG=False
# SECRET_KEY=<wygeneruj: python -c "import secrets; print(secrets.token_urlsafe(50))">
# ALLOWED_HOSTS=upadlosciowe.pl,www.upadlosciowe.pl,100.86.74.115
# CSRF_TRUSTED_ORIGINS=https://upadlosciowe.pl,https://www.upadlosciowe.pl
# COMING_SOON=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DB_PATH=/app/data/db.sqlite3
# MEDIA_ROOT=/app/media
# SITE_BASE_URL=https://upadlosciowe.pl
#
# Email (prod: SMTP; App Password z konta kontakt@upadlosciowe.pl):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=kontakt@upadlosciowe.pl
# EMAIL_HOST_PASSWORD=<app-password-16-znakow>
