# Env dla lokalnego kontenera testowego (docker-compose.local.yml).
# Prod-like, ale bez HTTPS: cookies niesecure, hosty localhost.
DEBUG=False
SECRET_KEY=lokalny-test-podmien-mnie
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8090,http://localhost:8090
COMING_SOON=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
DB_PATH=/app/data/db.sqlite3
MEDIA_ROOT=/app/media
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
OPERATOR_EMAIL=kontakt@upadlosciowe.pl
SITE_BASE_URL=http://127.0.0.1:8090
